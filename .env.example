# Remote API credentials
GEMINI_API_KEY=
MIMO_API_KEY=

# Cross-platform defaults; lower these values on low-memory computers.
MAX_CONCURRENT_TASKS=2
TRANSLATE_CONCURRENCY=2
TRANSLATE_BATCH_SIZE=20
TTS_CONCURRENCY=3

# Optional subtitle font. FFmpeg/libass will use system font fallback.
SUBTITLE_FONT=Arial

# Optional: protect /scan-directory and /register-local when set.
# Desktop builds inject this automatically; browser evil pages cannot guess it.
# SHIYIBAO_LOCAL_TOKEN=
